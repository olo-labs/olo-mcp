# Required. Never commit the real value.
OPENAI_API_KEY=

# OpenAI model configuration.
OPENAI_MODEL=gpt-5-mini
OPENAI_FALLBACK_MODEL=gpt-5-nano

# Dockerized MCP server.
MCP_URL=http://127.0.0.1:8000/mcp
ALLOWED_MCP_TOOLS=hello,get_current_time,calculate
MCP_TIMEOUT_SECONDS=15
MCP_CONNECT_ATTEMPTS=3

# Agent safety and reliability limits.
MAX_INPUT_CHARS=4000
MODEL_CALL_LIMIT=6
TOOL_CALL_LIMIT=8
AGENT_TIMEOUT_SECONDS=120
STRICT_PROMPT_GUARD=true
REQUIRE_TOOL_APPROVAL=false

# Local durable conversation state and logs.
AGENT_CHECKPOINT_DB=.agent-state/checkpoints.sqlite
AGENT_LOG_LEVEL=INFO

# Optional LangSmith tracing. Do not enable without configuring its API key.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=simple-mcp-console-agent
